# @jofr/capacitor-media-session@4 declares a peer dependency on @capacitor/core@^6
# while this project runs Capacitor 8. The plugin works fine on 8 (verified on
# device: lock-screen controls, background playback), but npm 7+ treats the
# mismatch as a hard error, which breaks `npm install` on CI and on Vercel.
legacy-peer-deps=true
